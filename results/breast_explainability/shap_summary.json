  "interpretation": {
    "shap_values_are": "model-attribution values describing how this trained model distributes its own output across its own inputs",
    "shap_values_are_not": [
      "causal effects",
      "evidence of a biological mechanism",
      "a validated biomarker ranking",
      "a basis for any clinical decision"
    ],
    "pam50_framing": "The PAM50 task is reproduction/recovery of the established PAM50 assignment from the same 50-gene panel that assignment derives from. High attribution to PAM50 genes is therefore expected by construction and is not independent molecular-subtype discovery.",
    "additivity": "Expected gradients is a sampling approximation, so the per-patient SHAP sum only approximately equals f(x) - E[f(background)]. The recorded additivity gap quantifies that approximation; it is a diagnostic, not an error."
  }
